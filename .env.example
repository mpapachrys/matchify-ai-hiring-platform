# ─────────────────────────────────────────────────────────────
# Matchify.ai — single .env feeds every container
# Copy to .env before running `make up`
# ─────────────────────────────────────────────────────────────

# ── Organization (single-tenant: this is the hiring company) ──
ORG_NAME=Matchify
ORG_WEBSITE=https://matchify.ai

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=matchify

# ── Auth ─────────────────────────────────────────────────────
# CHANGE THIS. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Anyone can self-register as a hiring manager. Fine for a demo, wrong for prod.
ALLOW_MANAGER_SIGNUP=true

# ── Object storage (MinIO) ───────────────────────────────────
# INTERNAL is how the API reaches MinIO over the compose network.
# PUBLIC is the host the browser resolves — presigned URLs are signed for it.
STORAGE_ENDPOINT_INTERNAL=http://minio:9000
STORAGE_ENDPOINT_PUBLIC=http://localhost:9000
STORAGE_ACCESS_KEY=matchify
STORAGE_SECRET_KEY=matchify-dev-secret
STORAGE_BUCKET=matchify
# Any label; server and client must agree (it is part of the signature).
STORAGE_REGION=local
PRESIGN_TTL_SECONDS=900
MAX_UPLOAD_MB=10

# ── Resume parsing (the only LLM use in this codebase) ───────
# stub       = regex only, no API key needed
# openrouter = an LLM reads the CV and fills the builder in
RESUME_PARSER=openrouter

# Get a key at https://openrouter.ai/keys — without it the app falls back to
# the stub engine and logs a warning rather than failing uploads.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model slug OpenRouter routes to. ~$0.04 per resume on this one.
AI_MODEL=anthropic/claude-opus-4-8


# Token the AI team's service presents to read the Neo4j graph export.
# Generate: openssl rand -hex 32 — empty disables those endpoints entirely.
INBOUND_AI_TOKEN=


# ── Calendar assistant (interview scheduling, mcp_calendar/) ──────
# Reaches the mcp_calendar sidecar over the compose network. This is the
# only .env calendar-mcp reads too — docker-compose passes every var below
# through to its container environment, so there's no second .env file to
# keep in sync (mcp_calendar/.env was retired 2026-07-25).
CALENDAR_ASSISTANT_URL=http://calendar-mcp:8090
# Shared secret both apps/api and calendar-mcp must agree on. Generate:
# openssl rand -hex 32 — empty disables interview scheduling entirely.
CALENDAR_ASSISTANT_TOKEN=

# Google OAuth 2.0 Client Credentials (Desktop app type, Google Cloud
# Console) — mcp_calendar's own Google Calendar API access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the completed OAuth token is saved/loaded. Generated once via the
# interactive flow (see mcp_calendar/README.md) — never regenerated inside
# a container (no browser, no tty there).
TOKEN_FILE_PATH=.gcp-saved-tokens.json
OAUTH_CALLBACK_PORT=8080
CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# mcp_calendar's own OpenRouter config, for the tool-calling scheduling
# decision. Deliberately separate names from RESUME_PARSER's and graph/'s
# OpenRouter vars above/below — three codebases, three OpenRouter accounts.
CALENDAR_MCP_OPENROUTER_API_KEY=
CALENDAR_MCP_OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Neo4j graph pipeline (graph/ — the AI team's matching pipeline) ──
# Only read by the graph/ codebase (graph/db.py, graph/api_client.py,
# graph/llm_client.py) — not by apps/api or apps/web. Aura connection info:
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# graph/'s side of INBOUND_AI_TOKEN above — same secret, different var name
# because it's a different codebase's config (graph/api_client.py).
MATCHIFY_API_BASE_URL=https://api.matchify.gr/api/v1
MATCHIFY_API_TOKEN=

# graph/'s own OpenRouter config, for the post-mandatory-match LLM evaluation
# (graph/matching.py). Deliberately separate names from RESUME_PARSER's
# OPENROUTER_API_KEY/AI_MODEL above — two codebases' configs for what happens
# to be the same kind of secret today.
OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash


# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true

# ── Frontend ─────────────────────────────────────────────────
# Server Components talk to the API over the compose network
API_INTERNAL_URL=http://api:8000
# The browser always talks to Next.js, which proxies /api/v1/* to the API
NEXT_PUBLIC_API_BASE=/api/v1
